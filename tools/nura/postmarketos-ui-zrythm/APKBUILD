# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# Kiosk UI for postmarketOS/Nura: boots straight into Zrythm in the labwc
# compositor (Wayland, PipeWire). labwc gives plugin windows and dialogs title
# bars, so they can be moved and closed by touch.
pkgname=postmarketos-ui-zrythm
pkgver=2
pkgrel=0
pkgdesc="Zrythm digital audio workstation as a kiosk (Wayland, labwc)"
arch="noarch"
url="https://www.zrythm.org/"
license="LicenseRef-ZrythmLicense"
options="!check pmb:drm pmb:support-systemd"
depends="
	dbus
	drm_info
	elogind
	jq
	labwc
	pipewire-alsa
	pipewire-tools
	postmarketos-base-ui
	postmarketos-base-ui-audio
	postmarketos-base-ui-networkmanager
	seatd
	tinydm
	wlr-randr
	xwayland
	zrythm
	"
_pmb_groups="audio seat"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	zrythm.desktop
	rc.xml
	themerc-override
	menu.xml
	autostart
	zrythm-session
	zrythm-kiosk
	zrythm.default
	50-zrythm-realtime.conf
	"

package() {
	install -Dm644 "$srcdir"/zrythm.desktop -t "$pkgdir"/usr/share/wayland-sessions/
	install -Dm644 "$srcdir"/rc.xml "$srcdir"/themerc-override "$srcdir"/menu.xml \
		"$srcdir"/autostart -t "$pkgdir"/etc/xdg/zrythm-labwc/
	install -Dm755 "$srcdir"/zrythm-session "$srcdir"/zrythm-kiosk -t "$pkgdir"/usr/libexec/zrythm/
	install -Dm644 "$srcdir"/zrythm.default "$pkgdir"/etc/default/zrythm
	install -Dm644 "$srcdir"/50-zrythm-realtime.conf \
		-t "$pkgdir"/usr/lib/systemd/system/tinydm.service.d/
}
