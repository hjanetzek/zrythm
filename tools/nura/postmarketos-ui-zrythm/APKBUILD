# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# Kiosk UI for postmarketOS/Nura: boots straight into Zrythm (cage, Wayland, PipeWire).
pkgname=postmarketos-ui-zrythm
pkgver=1
pkgrel=1
pkgdesc="Zrythm digital audio workstation as a kiosk (Wayland, cage)"
arch="noarch"
url="https://www.zrythm.org/"
license="LicenseRef-ZrythmLicense"
options="!check pmb:drm pmb:support-systemd"
depends="
	jq
	pipewire-alsa
	pipewire-tools
	postmarketos-base-ui-cage
	wlr-randr
	zrythm
	"
_pmb_groups="audio seat"
source="
	zrythm.sh
	zrythm-kiosk
	zrythm.default
	50-zrythm-realtime.conf
	"

package() {
	install -Dm644 "$srcdir"/zrythm.sh -t "$pkgdir"/etc/cage-ui/
	install -Dm755 "$srcdir"/zrythm-kiosk -t "$pkgdir"/usr/libexec/zrythm/
	install -Dm644 "$srcdir"/zrythm.default "$pkgdir"/etc/default/zrythm
	install -Dm644 "$srcdir"/50-zrythm-realtime.conf \
		-t "$pkgdir"/usr/lib/systemd/system/tinydm.service.d/
}
