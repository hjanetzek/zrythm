# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# Lenovo IdeaPad Duet (google-kukui) settings for the Zrythm kiosk. Installed
# automatically on images with both the device package and the Zrythm UI.
pkgname=zrythm-quirks-google-kukui
pkgver=1
pkgrel=0
pkgdesc="Zrythm kiosk on the Lenovo IdeaPad Duet: touchscreen rotation, CPU governor and idle states"
arch="noarch"
url="https://www.zrythm.org/"
license="LicenseRef-ZrythmLicense"
options="!check"
install_if="device-google-kukui postmarketos-ui-zrythm"
source="
	90-zrythm-touchscreen.rules
	zrythm-duet-cpu
	60-zrythm-duet-cpu.conf
	"

package() {
	install -Dm644 "$srcdir"/90-zrythm-touchscreen.rules -t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm755 "$srcdir"/zrythm-duet-cpu -t "$pkgdir"/usr/libexec/zrythm/
	install -Dm644 "$srcdir"/60-zrythm-duet-cpu.conf \
		-t "$pkgdir"/usr/lib/systemd/system/tinydm.service.d/
}
sha512sums="
