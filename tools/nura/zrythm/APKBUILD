# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# Zrythm for postmarketOS/Nura: /usr/bin/zrythm and its plugin scanner.
#
# There is no source tarball for this branch: build from a local checkout with
#   pmbootstrap build --src=/path/to/zrythm zrythm
# --src skips $source, so put the sources CPM would fetch (JUCE, CLAP,
# clap-helpers, the VST3 SDK, farbot, loop-tempo-estimator) into pmbootstrap's
# distfiles cache first (tools/nura/seed-distfiles.sh). The build then needs no
# network.
#
# Needs Qt 6.12 with CanvasPainter and TaskTree (tools/nura/qt6) and the
# libraries in tools/nura/deps.
pkgname=zrythm
pkgver=2.0.0_alpha7
pkgrel=0
pkgdesc="Highly automated and intuitive digital audio workstation"
url="https://www.zrythm.org/"
arch="aarch64 x86_64"
license="LicenseRef-ZrythmLicense"
# The tests are not built; run them on the build host.
options="!check"
# Qt loads its platform, image format and QML plugins at run time, and JUCE
# dlopen()s the X11 extension libraries (for the editor windows of plugins it
# hosts), so abuild cannot find these itself.
depends="
	font-dejavu
	qt6-qtbase-wayland
	qt6-qtcanvaspainter
	qt6-qtdeclarative
	qt6-qtsvg
	qt6-qttasktree
	qt6-qtwayland
	so:libXcomposite.so.1
	so:libXcursor.so.1
	so:libXext.so.6
	so:libXi.so.6
	so:libXinerama.so.1
	so:libXrandr.so.2
	so:libXrender.so.1
	xdg-utils
	"
makedepends="
	alsa-lib-dev
	au
	boost1.89-dev
	cmake
	elfutils-dev
	fmt-dev
	fontconfig-dev
	freetype-dev
	gsl-lite
	libsndfile-dev
	libx11-dev
	libxcb-dev
	libxcomposite-dev
	libxcursor-dev
	libxext-dev
	libxi-dev
	libxinerama-dev
	libxrandr-dev
	libxrender-dev
	libxml2-utils
	lilv-dev
	linux-headers
	lv2
	lv2-dev
	magic-enum
	mesa-dev
	mpmcqueue
	nlohmann-json
	nlohmann-json-schema-validator-dev
	onetbb-dev
	pkgconf
	python3
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtcanvaspainter-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	qt6-qtshadertools-dev
	qt6-qtsvg-dev
	qt6-qttasktree-dev
	qt6-qttools-dev
	samurai
	scnlib-dev
	spdlog-dev
	type-safe
	xdg-utils
	xxhash-dev
	zstd-dev
	"
subpackages="$pkgname-dbg"
# Keep these the same as the GIT_TAGs in package-lock.cmake.
_jucecommit=3fb5cbc0340758596dac39f7c8de47d562b4896e
_clapcommit=29ffcc273be7c7c651f6c9953b99e69700e2387a
_claphelperscommit=d0ddaf0b581e083a1f615d6509f1af907a5ce82c
_farbotcommit=2a2bd99eefada6c78dff04bc0692912366952a86
_ltecommit=987981c714cf1807284b1d8a85f21532b304bea9
_vst3tag=v3.8.0_build_66
# pffft, fetched by loop-tempo-estimator itself (source/cmake/pffft.cmake).
_pffftcommit=fbc4058602803f40dc554b8a5d2bcc694c005f2f
_pffftdir=jpommier-pffft-fbc405860280
# The VST3 SDK's submodules at $_vst3tag (base, cmake, pluginterfaces, public.sdk).
_vst3basecommit=3d2e82f8e6bff59c1d8b7a27491a29c2286b5206
_vst3cmakecommit=de6e54eeaaab35b7145f5c32c279b5e892146e04
_vst3pluginterfacescommit=31d6eeba6daaa3e2a8bfbe3e7a90ca0b7fbfbc1c
_vst3publicsdkcommit=a3911a4615dabbfdfd9d181ee26b05c70c289a95
source="
	JUCE-$_jucecommit.tar.gz::https://github.com/juce-framework/JUCE/archive/$_jucecommit.tar.gz
	clap-$_clapcommit.tar.gz::https://github.com/free-audio/clap/archive/$_clapcommit.tar.gz
	clap-helpers-$_claphelperscommit.tar.gz::https://github.com/alex-tee/clap-helpers/archive/$_claphelperscommit.tar.gz
	farbot-$_farbotcommit.tar.gz::https://github.com/zrythm/farbot/archive/$_farbotcommit.tar.gz
	loop-tempo-estimator-$_ltecommit.tar.gz::https://github.com/saintmatthieu/loop-tempo-estimator/archive/$_ltecommit.tar.gz
	vst3sdk-$_vst3tag.tar.gz::https://github.com/steinbergmedia/vst3sdk/archive/refs/tags/$_vst3tag.tar.gz
	vst3_base-$_vst3basecommit.tar.gz::https://github.com/steinbergmedia/vst3_base/archive/$_vst3basecommit.tar.gz
	vst3_cmake-$_vst3cmakecommit.tar.gz::https://github.com/steinbergmedia/vst3_cmake/archive/$_vst3cmakecommit.tar.gz
	vst3_pluginterfaces-$_vst3pluginterfacescommit.tar.gz::https://github.com/steinbergmedia/vst3_pluginterfaces/archive/$_vst3pluginterfacescommit.tar.gz
	vst3_public_sdk-$_vst3publicsdkcommit.tar.gz::https://github.com/steinbergmedia/vst3_public_sdk/archive/$_vst3publicsdkcommit.tar.gz
	pffft-$_pffftcommit.tar.gz::https://bitbucket.org/jpommier/pffft/get/$_pffftcommit.tar.gz
	"
builddir="$srcdir/$pkgname"

# Unpacks distfile $1 into $srcdir (as directory $2, the archive's top-level
# directory) unless it is unpacked already. The distfile is looked up in
# abuild's SRCDEST, in pmbootstrap's distfiles cache (mounted at
# /var/cache/distfiles; abuild uses another SRCDEST when ~/.cache/abuild exists
# or the cache is not writable) and in $srcdir.
_unpack() {
	[ -d "$srcdir/$2" ] && return 0
	local f dir
	for dir in "$SRCDEST" /var/cache/distfiles "$srcdir"; do
		f="$dir/$1"
		[ -e "$f" ] && break
	done
	[ -e "$f" ] || die "$1 missing from $SRCDEST and /var/cache/distfiles: run tools/nura/seed-distfiles.sh"
	tar -xzf "$f" -C "$srcdir"
}

prepare() {
	default_prepare

	# With --src, abuild has not fetched or unpacked $source: use the distfiles cache.
	_unpack JUCE-$_jucecommit.tar.gz JUCE-$_jucecommit
	_unpack clap-$_clapcommit.tar.gz clap-$_clapcommit
	_unpack clap-helpers-$_claphelperscommit.tar.gz clap-helpers-$_claphelperscommit
	_unpack farbot-$_farbotcommit.tar.gz farbot-$_farbotcommit
	if ! [ -d "$srcdir"/loop-tempo-estimator-$_ltecommit ]; then
		_unpack loop-tempo-estimator-$_ltecommit.tar.gz loop-tempo-estimator-$_ltecommit
		# The PATCHES of its declaration in package-lock.cmake.
		(cd "$srcdir"/loop-tempo-estimator-$_ltecommit &&
			patch -p1 -i "$builddir"/cmake/patches/loop-tempo-estimator-0.0.5-include-vector.patch) ||
			die "patching loop-tempo-estimator failed"
	fi
	_unpack pffft-$_pffftcommit.tar.gz $_pffftdir
	grep -q "GIT_TAG $_pffftcommit" "$srcdir"/loop-tempo-estimator-$_ltecommit/source/cmake/pffft.cmake ||
		die "_pffftcommit differs from loop-tempo-estimator's source/cmake/pffft.cmake"
	_unpack vst3sdk-$_vst3tag.tar.gz vst3sdk-${_vst3tag#v}
	_unpack vst3_base-$_vst3basecommit.tar.gz vst3_base-$_vst3basecommit
	_unpack vst3_cmake-$_vst3cmakecommit.tar.gz vst3_cmake-$_vst3cmakecommit
	_unpack vst3_pluginterfaces-$_vst3pluginterfacescommit.tar.gz vst3_pluginterfaces-$_vst3pluginterfacescommit
	_unpack vst3_public_sdk-$_vst3publicsdkcommit.tar.gz vst3_public_sdk-$_vst3publicsdkcommit

	# The VST3 SDK with its submodules in place (the archive has empty
	# directories for them).
	local sdk="$srcdir"/vst3sdk-${_vst3tag#v} sub dir
	for sub in base:vst3_base-$_vst3basecommit cmake:vst3_cmake-$_vst3cmakecommit \
		pluginterfaces:vst3_pluginterfaces-$_vst3pluginterfacescommit \
		public.sdk:vst3_public_sdk-$_vst3publicsdkcommit; do
		dir=${sub#*:}
		sub=${sub%%:*}
		rmdir "$sdk/$sub" 2>/dev/null || true
		[ -e "$sdk/$sub" ] || mv "$srcdir/$dir" "$sdk/$sub"
	done

	local c
	for c in $_jucecommit $_clapcommit $_claphelperscommit $_farbotcommit $_ltecommit $_vst3tag; do
		grep -q "GIT_TAG $c" package-lock.cmake ||
			die "$c is not a GIT_TAG in package-lock.cmake: update the APKBUILD"
	done
	# pmbootstrap --src replaces pkgver with <version>_p<timestamp>, without the
	# pre-release suffix (_alpha7): then only the version numbers are compared.
	local version
	version=$(sed 's/^v//; s/-alpha\./_alpha/; s/-beta\./_beta/; s/-rc\./_rc/' VERSION.txt)
	case $pkgver in
	*_p[0-9]*) [ "${version%%_*}" = "${pkgver%%_*}" ] ;;
	*) [ "$version" = "$pkgver" ] ;;
	esac || die "pkgver $pkgver does not match VERSION.txt ($(cat VERSION.txt))"
}

build() {
	# musl hides stat64 and the other *64 types without this.
	export CFLAGS="$CFLAGS -D_LARGEFILE64_SOURCE"
	export CXXFLAGS="$CXXFLAGS -D_LARGEFILE64_SOURCE"
	# Tuned for the Lenovo Duet's Cortex-A73 cores (MT8183: 4x A73, 4x A53). The
	# A73's instruction set is ARMv8.0 with CRC, so the package still runs on the
	# A53s and on other ARMv8 boards.
	case "$CARCH" in
	aarch64)
		export CFLAGS="$CFLAGS -mcpu=cortex-a73"
		export CXXFLAGS="$CXXFLAGS -mcpu=cortex-a73"
		;;
	esac

	# RelWithDebInfo with -g1: function names and lines for backtraces and perf
	# (in zrythm-dbg) at a fraction of the size of full debug info. No LTO: its
	# code generation would run under qemu in pmbootstrap.
	# ZRYTHM_WITH_LIBDW: backtraces through libgcc's unwinder and libdw; musl has
	# no execinfo.h, backward-cpp's default.
	# The CPM packages are taken from $srcdir through FetchContent's source
	# directory overrides, which keep the declarations in package-lock.cmake
	# (DOWNLOAD_ONLY, SOURCE_SUBDIR); CPM's own CPM_<name>_SOURCE overrides drop
	# them. FetchContent does not patch an overridden source: prepare() applies
	# the declared PATCHES.
	# The flags are passed explicitly: CMake takes them from the environment only
	# when it first configures a build directory, and pmbootstrap --lax keeps that
	# directory. build-nura/ matches .gitignore, so pmbootstrap's rsync of the
	# checkout neither copies nor deletes it.
	cmake -S . -B build-nura -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_C_FLAGS="$CFLAGS" \
		-DCMAKE_CXX_FLAGS="$CXXFLAGS" \
		-DCMAKE_C_FLAGS_RELWITHDEBINFO="-O2 -g1 -DNDEBUG" \
		-DCMAKE_CXX_FLAGS_RELWITHDEBINFO="-O2 -g1 -DNDEBUG" \
		-DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS" \
		-DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS" \
		-DCMAKE_MODULE_LINKER_FLAGS="$LDFLAGS" \
		-DZRYTHM_LTO=OFF \
		-DZRYTHM_BUNDLE_RUNTIME=OFF \
		-DZRYTHM_CHECK_UPDATES=OFF \
		-DZRYTHM_MANPAGE=OFF \
		-DZRYTHM_SHELL_COMPLETIONS=OFF \
		-DZRYTHM_TESTS=OFF \
		-DZRYTHM_WITH_LIBDW=ON \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON \
		-DFETCHCONTENT_SOURCE_DIR_JUCE="$srcdir"/JUCE-$_jucecommit \
		-DFETCHCONTENT_SOURCE_DIR_CLAP="$srcdir"/clap-$_clapcommit \
		-DFETCHCONTENT_SOURCE_DIR_CLAP-HELPERS="$srcdir"/clap-helpers-$_claphelperscommit \
		-DFETCHCONTENT_SOURCE_DIR_FARBOT="$srcdir"/farbot-$_farbotcommit \
		-DFETCHCONTENT_SOURCE_DIR_LOOP-TEMPO-ESTIMATOR="$srcdir"/loop-tempo-estimator-$_ltecommit \
		-DFETCHCONTENT_SOURCE_DIR_VST3SDK="$srcdir"/vst3sdk-${_vst3tag#v} \
		-DFETCHCONTENT_SOURCE_DIR_PFFFT="$srcdir"/$_pffftdir
	# pmbootstrap's job count (JOBS, its "jobs" setting, default one per core),
	# but at most one job per 2 GB of available memory: some of Zrythm's
	# translation units need over 1.5 GB to compile.
	local jobs="${JOBS:-$(nproc)}" memjobs
	memjobs=$(awk '/^MemAvailable:/ { print int($2 / 2000000) }' /proc/meminfo)
	[ "${memjobs:-0}" -ge 1 ] || memjobs=1
	[ "$jobs" -le "$memjobs" ] || jobs=$memjobs
	msg "Building with $jobs jobs"
	cmake --build build-nura -j "$jobs"
}

package() {
	DESTDIR="$pkgdir" cmake --install build-nura
}

