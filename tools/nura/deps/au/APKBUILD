# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# zrythm: build dependency of Zrythm that aports does not package (see ../../README.md)
pkgname=au
pkgver=0.5.0
pkgrel=0
pkgdesc="C++ quantities and units library"
url="https://aurora-opensource.github.io/au/"
arch="noarch"
license="Apache-2.0"
makedepends="cmake samurai"
options="!check" # header-only; the tests need extra dependencies
source="au-$pkgver.tar.gz::https://github.com/aurora-opensource/au/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/au-$pkgver"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DAU_EXCLUDE_GTEST_DEPENDENCY=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
4be3d1c4f595852d57352572d58137b98c5a51074926cf06fe65420c277f72dc2f03d61bb25e87ceb3e4050181145557766e77af19c6aee7b0d1fe7ec3a8029b  au-0.5.0.tar.gz
"
